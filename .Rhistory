#02_eda.R
#Exploratory Data Analysis — distributions, correlations, group summaries
#Author: Ramya Sri Jayashanker Chithra
library(tidyverse)
nhanes <- readRDS("D:/Documents/Project-Portfolio/Dietry-Cardiometabolic-Bayes/nhanes_clean.rds")
#1. Summary statistics
summary_table <- nhanes %>%
summarise(
across(
c(bmi, waist_cm, energy_kcal, sugar_g, sat_fat_g, total_fat_g, age),
list(
mean   = ~round(mean(.x, na.rm = TRUE), 2),
sd     = ~round(sd(.x, na.rm = TRUE), 2),
median = ~round(median(.x, na.rm = TRUE), 2),
min    = ~round(min(.x, na.rm = TRUE), 2),
max    = ~round(max(.x, na.rm = TRUE), 2)
)
)
)
print(summary_table)
#by sex
nhanes %>%
group_by(sex) %>%
summarise(
n           = n(),
mean_bmi    = round(mean(bmi, na.rm = TRUE), 2),
mean_waist  = round(mean(waist_cm, na.rm = TRUE), 2),
mean_sugar  = round(mean(sugar_g, na.rm = TRUE), 2),
mean_satfat = round(mean(sat_fat_g, na.rm = TRUE), 2)
) %>%
print()
#by age group
nhanes %>%
group_by(age_group) %>%
summarise(
n           = n(),
mean_bmi    = round(mean(bmi, na.rm = TRUE), 2),
mean_waist  = round(mean(waist_cm, na.rm = TRUE), 2),
mean_sugar  = round(mean(sugar_g, na.rm = TRUE), 2),
mean_satfat = round(mean(sat_fat_g, na.rm = TRUE), 2)
) %>%
print()
#2. Distribution plots
#BMI distribution by sex
p1 <- ggplot(nhanes, aes(x = bmi, fill = sex)) +
geom_histogram(bins = 40, alpha = 0.7, position = "identity") +
facet_wrap(~sex) +
scale_fill_manual(values = c("#2C7BB6", "#D7191C")) +
labs(
title = "BMI Distribution by Sex",
subtitle = "NHANES 2017-2018, Adults 18+",
x = "BMI (kg/m²)", y = "Count"
) +
theme_minimal(base_size = 13) +
theme(legend.position = "none")
ggsave("output/01_bmi_distribution.png", p1, width = 8, height = 5, dpi = 150)
#02_eda.R
#Exploratory Data Analysis — distributions, correlations, group summaries
#Author: Ramya Sri Jayashanker Chithra
library(tidyverse)
nhanes <- readRDS("D:/Documents/Project-Portfolio/Dietry-Cardiometabolic-Bayes/nhanes_clean.rds")
#1. Summary statistics
summary_table <- nhanes %>%
summarise(
across(
c(bmi, waist_cm, energy_kcal, sugar_g, sat_fat_g, total_fat_g, age),
list(
mean   = ~round(mean(.x, na.rm = TRUE), 2),
sd     = ~round(sd(.x, na.rm = TRUE), 2),
median = ~round(median(.x, na.rm = TRUE), 2),
min    = ~round(min(.x, na.rm = TRUE), 2),
max    = ~round(max(.x, na.rm = TRUE), 2)
)
)
)
print(summary_table)
#by sex
nhanes %>%
group_by(sex) %>%
summarise(
n           = n(),
mean_bmi    = round(mean(bmi, na.rm = TRUE), 2),
mean_waist  = round(mean(waist_cm, na.rm = TRUE), 2),
mean_sugar  = round(mean(sugar_g, na.rm = TRUE), 2),
mean_satfat = round(mean(sat_fat_g, na.rm = TRUE), 2)
) %>%
print()
#by age group
nhanes %>%
group_by(age_group) %>%
summarise(
n           = n(),
mean_bmi    = round(mean(bmi, na.rm = TRUE), 2),
mean_waist  = round(mean(waist_cm, na.rm = TRUE), 2),
mean_sugar  = round(mean(sugar_g, na.rm = TRUE), 2),
mean_satfat = round(mean(sat_fat_g, na.rm = TRUE), 2)
) %>%
print()
#2. Distribution plots
#BMI distribution by sex
p1 <- ggplot(nhanes, aes(x = bmi, fill = sex)) +
geom_histogram(bins = 40, alpha = 0.7, position = "identity") +
facet_wrap(~sex) +
scale_fill_manual(values = c("#2C7BB6", "#D7191C")) +
labs(
title = "BMI Distribution by Sex",
subtitle = "NHANES 2017-2018, Adults 18+",
x = "BMI (kg/m²)", y = "Count"
) +
theme_minimal(base_size = 13) +
theme(legend.position = "none")
ggsave("output/01_bmi_distribution.png", p1, width = 8, height = 5, dpi = 150)
#Sugar intake distribution
p2 <- ggplot(nhanes, aes(x = sugar_g, fill = age_group)) +
geom_histogram(bins = 40, alpha = 0.75, position = "identity") +
facet_wrap(~age_group) +
scale_fill_brewer(palette = "Set2") +
labs(
title = "Total Sugar Intake by Age Group",
subtitle = "NHANES 2017-2018, Adults 18+",
x = "Total Sugars (g/day)", y = "Count"
) +
theme_minimal(base_size = 13) +
theme(legend.position = "none")
ggsave("output/02_sugar_distribution.png", p2, width = 9, height = 5, dpi = 150)
#3. Scatter plots — dietary intake vs. BMI
p3 <- ggplot(nhanes, aes(x = sugar_g, y = bmi, colour = sex)) +
geom_point(alpha = 0.25, size = 0.8) +
geom_smooth(method = "lm", se = TRUE, linewidth = 1) +
scale_colour_manual(values = c("#2C7BB6", "#D7191C")) +
facet_wrap(~age_group) +
labs(
title = "Sugar Intake vs. BMI by Age Group",
subtitle = "NHANES 2017-2018 | Linear trend lines by sex",
x = "Total Sugars (g/day)", y = "BMI (kg/m²)",
colour = "Sex"
) +
theme_minimal(base_size = 12)
ggsave("output/03_sugar_vs_bmi.png", p3, width = 10, height = 6, dpi = 150)
p4 <- ggplot(nhanes, aes(x = sat_fat_g, y = waist_cm, colour = sex)) +
geom_point(alpha = 0.25, size = 0.8) +
geom_smooth(method = "lm", se = TRUE, linewidth = 1) +
scale_colour_manual(values = c("#2C7BB6", "#D7191C")) +
facet_wrap(~age_group) +
labs(
title = "Saturated Fat Intake vs. Waist Circumference by Age Group",
subtitle = "NHANES 2017-2018 | Linear trend lines by sex",
x = "Saturated Fat (g/day)", y = "Waist Circumference (cm)",
colour = "Sex"
) +
theme_minimal(base_size = 12)
ggsave("output/04_satfat_vs_waist.png", p4, width = 10, height = 6, dpi = 150)
#4. Correlation matrix of dietary and outcome variables
cor_vars <- nhanes %>%
select(bmi, waist_cm, energy_kcal, sugar_g, sat_fat_g, total_fat_g, protein_g, age) %>%
cor(use = "complete.obs") %>%
round(3)
print(cor_vars)
cat("\nEDA complete. Plots saved to output/\n")
